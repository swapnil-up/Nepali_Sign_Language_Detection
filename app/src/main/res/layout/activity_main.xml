<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <include
            android:id="@+id/toolbarUser"
            layout="@layout/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <HorizontalScrollView
            android:id="@+id/horizontalScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:scrollbars="none"
            android:background="@color/textPrimary"
            app:layout_constraintTop_toBottomOf="@+id/toolbarUser">

            <TextView
                android:id="@+id/lastResultTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="Last Detected Result:"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/black"
            app:layout_constraintBottom_toTopOf="@+id/resultTextView"
            app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView">

            <TextureView
                android:id="@+id/textureView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <com.example.nsl_mini.LandmarkOverlayView
                android:id="@+id/landmarkOverlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/targetCharacterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="140sp"
                android:textColor="@color/white"
                android:shadowColor="@color/black"
                android:shadowRadius="12"
                android:shadowDx="3"
                android:shadowDy="3"
                android:visibility="gone"
                android:typeface="serif" />

            <TextView
                android:id="@+id/practiceHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="56dp"
                android:text="Show sign"
                android:textSize="13sp"
                android:textColor="@color/accentLight"
                android:background="@drawable/hint_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:shadowColor="@color/black"
                android:shadowRadius="4"
                android:shadowDx="1"
                android:shadowDy="1"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/practiceFeedbackText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="20dp"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:shadowColor="@color/black"
                android:shadowRadius="6"
                android:shadowDx="2"
                android:shadowDy="2"
                android:visibility="gone" />

            <TextView
                android:id="@+id/practiceProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:shadowColor="@color/black"
                android:shadowRadius="4"
                android:shadowDx="1"
                android:shadowDy="1"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/resultTextView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/textPrimary"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/controlsBar"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/controlsBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/textPrimary"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/practiceModeButton"
                style="@style/TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:layout_marginHorizontal="2dp"
                android:text="Practice"
                android:textSize="12sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/switchCameraButton"
                style="@style/IconButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="1dp"
                android:text="Cam"
                android:textSize="10sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/backspaceButton"
                style="@style/IconButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="1dp"
                android:text="Del"
                android:textSize="10sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/clearButton"
                style="@style/IconButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="1dp"
                android:text="Clr"
                android:textSize="10sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/speakButton"
                style="@style/IconButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="1dp"
                android:text="TTS"
                android:textSize="10sp"
                android:textAllCaps="false" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        android:background="@color/surface"
        app:menu="@menu/nav_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>
